<%- include('../partials/header') %>

<%
  const isEdit = mode === 'edit';
  const action = isEdit ? '/films/' + film.id + '/edit' : '/films';
  const nilai = (field) => (film[field] === undefined || film[field] === null ? '' : film[field]);
%>

<a href="/films" class="back">&larr; Kembali ke daftar</a>

<section class="card form-card">
  <div class="form-head">
    <p class="eyebrow"><%= isEdit ? 'Ubah data' : 'Data baru' %></p>
    <h1><%= isEdit ? 'Edit Film' : 'Tambah Film' %></h1>
  </div>

  <% if (errors.length) { %>
    <div class="alert alert-error">
      <strong>Periksa lagi isian kamu:</strong>
      <ul>
        <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form action="<%= action %>" method="POST" class="form">
    <div class="field field-full">
      <label for="judul">Judul Film</label>
      <input type="text" id="judul" name="judul" value="<%= nilai('judul') %>"
             placeholder="contoh: Laskar Pelangi" maxlength="255" required>
    </div>

    <div class="field field-full">
      <label for="sutradara">Sutradara</label>
      <input type="text" id="sutradara" name="sutradara" value="<%= nilai('sutradara') %>"
             placeholder="contoh: Riri Riza" maxlength="100" required>
    </div>

    <div class="field">
      <label for="genre">Genre</label>
      <select id="genre" name="genre" required>
        <option value="">-- Pilih genre --</option>
        <% genres.forEach((g) => { %>
          <option value="<%= g %>" <%= nilai('genre') === g ? 'selected' : '' %>><%= g %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="tahun">Tahun Rilis</label>
      <input type="number" id="tahun" name="tahun" value="<%= nilai('tahun') %>"
             placeholder="2024" min="1888" max="2100" required>
    </div>

    <div class="field">
      <label for="rating">Rating (0 - 10)</label>
      <input type="number" id="rating" name="rating" value="<%= nilai('rating') %>"
             placeholder="8.5" min="0" max="10" step="0.1" required>
    </div>

    <div class="form-actions field-full">
      <a href="/films" class="btn btn-ghost">Batal</a>
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Simpan Perubahan' : 'Simpan Film' %></button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>